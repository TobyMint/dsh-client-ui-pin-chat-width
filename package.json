{
  "name": "dsh-client-ui-pin-chat-width",
  "version": "0.2.1",
  "type": "module",
  "description": "Pins the Web conversation width by hiding the transcript drag handles that resize the column and composer",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TobyMint/dsh-client-ui-pin-chat-width.git"
  },
  "homepage": "https://github.com/TobyMint/dsh-client-ui-pin-chat-width#readme",
  "bugs": {
    "url": "https://github.com/TobyMint/dsh-client-ui-pin-chat-width/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
